{
  "name": "gh-mobile-plus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "test": "vitest run",
    "e2e": "playwright test",
    "i18n:check": "node scripts/check-i18n.ts",
    "build": "pnpm run licenses && vite build",
    "size": "node scripts/check-size.ts",
    "ci:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm i18n:check && pnpm test && pnpm build && pnpm size && pnpm e2e",
    "gql:generate": "gql-tada generate output --tsconfig tsconfig.app.json",
    "icons": "node scripts/generate-icons.ts",
    "licenses": "node scripts/generate-licenses.ts"
  },
  "dependencies": {
    "@0no-co/graphql.web": "1.3.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-persist-client": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "dompurify": "3.4.18",
    "gql.tada": "1.11.5",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "1.18.0",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@cloudflare/workers-types": "5.20261116.1",
    "@eslint/js": "10.0.1",
    "@msw/playwright": "0.7.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "graphql": "17.1.0",
    "jsdom": "31.0.1",
    "msw": "3.0.6",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "wrangler": "4.162.0"
  }
}
