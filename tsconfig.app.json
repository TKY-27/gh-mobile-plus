{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "plugins": [
      {
        "name": "@0no-co/graphqlsp",
        "schema": "./schema/github.graphql",
        "tadaOutputLocation": "./src/data/graphql-env.d.ts"
      }
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/sw.ts"]
}
